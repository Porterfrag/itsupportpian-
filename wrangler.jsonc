{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itsupportpian",
  "compatibility_date": "2026-11-08",

  // Situs statis hasil `npm run build` (folder dist/)
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  // Domain produksi
  "routes": [{ "pattern": "itsupportpian.my.id", "custom_domain": true }]
}
