---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { site, waLink } from '../../data/site';

const demoWa = waLink(
  'Halo PIAN! Ulun lihat contoh undangan digital di website. Ulun handak beulah undangan digital gasan acara ulun.',
);

const gallery = [
  { label: 'Foto 1', tone: 'from-[#e8e4dc] to-[#cfc7b8]' },
  { label: 'Foto 2', tone: 'from-[#dfe3e0] to-[#b8c2bb]' },
  { label: 'Foto 3', tone: 'from-[#e6dede] to-[#c8b6b6]' },
];
---

<Layout
  title="Contoh Undangan Digital — IT Support PIAN!"
  description="Contoh undangan digital buatan IT Support PIAN!. Bisa untuk pernikahan, aqiqah, khitanan, dan acara lainnya."
>
  <div class="border-b-2 border-ink bg-accent">
    <div class="container-x flex flex-wrap items-center justify-between gap-3 py-3">
      <p class="text-[11px] font-extrabold uppercase tracking-[0.16em]">
        Contoh undangan digital · dibuat oleh IT Support PIAN!
      </p>
      <div class="flex items-center gap-2">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 rounded-full border-2 border-ink bg-paper px-3.5 py-1.5 text-[11px] font-extrabold uppercase tracking-wide"
        >
          ← Beranda
        </a>
        <a
          href={demoWa}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 rounded-full border-2 border-ink bg-ink px-3.5 py-1.5 text-[11px] font-extrabold uppercase tracking-wide text-paper"
        >
          <Icon name="whatsapp" class="h-3.5 w-3.5" />
          Pesan yang seperti ini
        </a>
      </div>
    </div>
  </div>

  <!-- ===== Cover ===== -->
  <section class="relative overflow-hidden border-b-2 border-ink bg-soft">
    <div class="container-x flex min-h-[86vh] flex-col items-center justify-center py-16 text-center">
      <p class="kicker text-ink/50">The Wedding Of</p>

      <h1 class="mt-6 text-[clamp(2.5rem,9vw,5rem)] leading-[0.9]">
        Aulia<br />
        <span class="text-[0.5em] tracking-[0.3em] text-ink/40">&amp;</span><br />
        Rizky
      </h1>

      <div class="mt-8 flex items-center gap-3 text-xs font-extrabold uppercase tracking-[0.2em] text-ink/60">
        <span class="h-px w-10 bg-ink/30"></span>
        12 · 12 · 2026
        <span class="h-px w-10 bg-ink/30"></span>
      </div>

      <p class="mt-6 max-w-md text-sm leading-relaxed text-ink/60">
        Dengan memohon rahmat Allah SWT, kami mengundang Bapak/Ibu/Saudara untuk hadir di acara
        pernikahan kami.
      </p>

      <!-- Hitung mundur -->
      <div class="mt-9 grid w-full max-w-md grid-cols-4 gap-2" data-countdown>
        {['Hari', 'Jam', 'Menit', 'Detik'].map((unit, i) => (
          <div class="rounded-xl border-2 border-ink bg-paper px-2 py-3">
            <span
              class="block font-display text-xl leading-none sm:text-2xl"
              data-unit={['d', 'h', 'm', 's'][i]}
            >
              00
            </span>
            <span class="mt-1.5 block text-[9px] font-bold uppercase tracking-widest text-ink/45">
              {unit}
            </span>
          </div>
        ))}
      </div>

      <div class="mt-9 flex flex-col items-center gap-2">
        <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-ink/40">
          Kepada Bapak/Ibu/Saudara
        </span>
        <span class="rounded-full border-2 border-ink bg-accent px-6 py-2 text-sm font-extrabold">
          Tamu Undangan
        </span>
      </div>
    </div>
  </section>

  <!-- ===== Mempelai ===== -->
  <section class="border-b-2 border-ink bg-paper py-16">
    <div class="container-x text-center">
      <p class="kicker justify-center text-ink/50">Bride &amp; Groom</p>
      <h2 class="mt-4 text-[clamp(1.75rem,4.5vw,2.75rem)]">Kami yang berbahagia</h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          [
            { name: 'Aulia Rahmadani', role: 'Putri dari Bapak H. Ahmad & Ibu Hj. Siti' },
            { name: 'Rizky Pratama', role: 'Putra dari Bapak H. Yusuf & Ibu Hj. Aminah' },
          ].map((person) => (
            <div class="rounded-2xl border-2 border-ink bg-soft p-7 shadow-hard-sm">
              <div class="mx-auto h-24 w-24 rounded-full border-2 border-ink bg-[linear-gradient(135deg,#e9e5dd,#cfc7b8)]" />
              <h3 class="mt-5 font-sans text-lg font-extrabold normal-case tracking-normal">
                {person.name}
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-ink/55">{person.role}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Acara ===== -->
  <section class="border-b-2 border-ink bg-ink py-16 text-paper">
    <div class="container-x text-center">
      <p class="kicker justify-center text-accent">Save The Date</p>
      <h2 class="mt-4 text-[clamp(1.75rem,4.5vw,2.75rem)]">Waktu &amp; tempat</h2>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          [
            { title: 'Akad Nikah', time: '08.00 – 10.00 WITA', place: 'Masjid Sultan Suriansyah, Banjarmasin' },
            { title: 'Resepsi', time: '11.00 – 14.00 WITA', place: 'Kediaman Mempelai, Jl. Ahmad Yani KM 5' },
          ].map((ev) => (
            <div class="rounded-2xl border-2 border-paper/15 bg-paper/[0.04] p-6">
              <h3 class="text-xl text-accent">{ev.title}</h3>
              <p class="mt-3 flex items-center gap-2 text-sm text-paper/75">
                <Icon name="clock" class="h-4 w-4 shrink-0" strokeWidth="2" />
                {ev.time}
              </p>
              <p class="mt-2 flex items-start gap-2 text-sm leading-relaxed text-paper/75">
                <Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth="2" />
                {ev.place}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Galeri ===== -->
  <section class="border-b-2 border-ink bg-soft py-16">
    <div class="container-x">
      <p class="kicker justify-center text-ink/50">Gallery</p>
      <h2 class="mt-4 text-center text-[clamp(1.75rem,4.5vw,2.75rem)]">Momen kami</h2>

      <div class="mt-10 grid grid-cols-3 gap-2 sm:gap-4">
        {
          gallery.map((item) => (
            <div class={`aspect-[3/4] rounded-xl border-2 border-ink bg-gradient-to-br ${item.tone}`} />
          ))
        }
      </div>
      <p class="mt-4 text-center text-xs text-ink/40">
        *Foto bisa diganti dengan foto asli mempelai
      </p>
    </div>
  </section>

  <!-- ===== RSVP ===== -->
  <section class="border-b-2 border-ink bg-paper py-16">
    <div class="container-x max-w-2xl">
      <p class="kicker justify-center text-ink/50">RSVP</p>
      <h2 class="mt-4 text-center text-[clamp(1.75rem,4.5vw,2.75rem)]">Konfirmasi kehadiran</h2>
      <p class="mx-auto mt-4 max-w-md text-center text-sm leading-relaxed text-ink/60">
        Bantu kami mempersiapkan acara dengan mengisi konfirmasi kehadiran lewat WhatsApp.
      </p>

      <div class="mt-8 rounded-2xl border-2 border-ink bg-soft p-6 shadow-hard-sm">
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block">
            <span class="mb-1.5 block text-[11px] font-extrabold uppercase tracking-widest text-ink/50">
              Nama
            </span>
            <input
              type="text"
              placeholder="Nama pian"
              class="w-full rounded-lg border-2 border-ink/15 bg-paper px-3.5 py-2.5 text-sm outline-none focus:border-ink"
            />
          </label>
          <label class="block">
            <span class="mb-1.5 block text-[11px] font-extrabold uppercase tracking-widest text-ink/50">
              Jumlah tamu
            </span>
            <input
              type="number"
              min="1"
              value="1"
              class="w-full rounded-lg border-2 border-ink/15 bg-paper px-3.5 py-2.5 text-sm outline-none focus:border-ink"
            />
          </label>
        </div>
        <button
          type="button"
          class="mt-4 w-full rounded-full border-2 border-ink bg-accent px-6 py-3 text-xs font-extrabold uppercase tracking-wide transition-transform hover:scale-[1.01]"
        >
          Kirim konfirmasi
        </button>
        <p class="mt-3 text-center text-[11px] text-ink/40">
          *Contoh saja — di undangan asli, konfirmasi langsung masuk ke WhatsApp pemilik acara
        </p>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="bg-accent py-14">
    <div class="container-x text-center">
      <h2 class="mx-auto max-w-2xl text-[clamp(1.75rem,5vw,3rem)]">
        Handak undangan digital<br class="hidden sm:block" /> yang seperti ini?
      </h2>
      <p class="mx-auto mt-4 max-w-md text-sm font-medium leading-relaxed text-ink/70">
        Desain disesuaikan dengan tema acara pian. Bisa pakai nama tamu, galeri foto, musik, RSVP,
        dan peta lokasi.
      </p>
      <a
        href={demoWa}
        target="_blank"
        rel="noopener"
        class="mt-7 inline-flex items-center gap-2.5 rounded-full border-2 border-ink bg-ink px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-paper shadow-hard-sm transition-all hover:-translate-y-0.5 active:translate-y-0 active:shadow-none"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        Chat WhatsApp
      </a>
      <p class="mt-4 text-xs font-bold uppercase tracking-widest text-ink/50">
        {site.waDisplay}
      </p>
    </div>
  </section>

  <footer class="bg-ink py-8 text-center text-paper">
    <p class="text-xs text-paper/40">
      Contoh undangan digital oleh
      <a href="/" class="font-bold text-accent underline underline-offset-2">{site.name}</a>
    </p>
  </footer>

  <script>
    // Hitung mundur ke tanggal acara
    const target = new Date('2026-12-12T08:00:00+08:00').getTime();
    const boxes = document.querySelectorAll<HTMLElement>('[data-countdown] [data-unit]');

    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);

      const values: Record<string, number> = { d, h, m, s };
      boxes.forEach((box) => {
        const unit = box.dataset.unit ?? '';
        box.textContent = String(values[unit] ?? 0).padStart(2, '0');
      });
    };

    tick();
    setInterval(tick, 1000);
  </script>
</Layout>
