---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { site, waLink } from '../../data/site';
import { layananPages } from '../../data/layanan';

const title = 'Layanan IT Support di Banjarmasin — Servis, Aplikasi, Undangan Digital | IT Support PIAN!';
const description =
  'Daftar layanan IT Support PIAN! di Banjarmasin: servis komputer & laptop, pembuatan aplikasi kustom, undangan digital, dan instalasi jaringan. Konsultasi awal gratis.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Layanan', item: `${site.url}/layanan/` },
  ],
};

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Layanan IT Support PIAN!',
  itemListElement: layananPages.map((page, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: page.h1,
    url: `${site.url}/layanan/${page.slug}/`,
  })),
};
---

<Layout title={title} description={description} jsonLd={[breadcrumbSchema, listSchema]}>
  <Header />

  <main>
    <section class="border-b-2 border-ink bg-paper">
      <div class="container-x py-10 sm:py-14">
        <nav aria-label="Breadcrumb" class="text-xs font-bold uppercase tracking-wider text-ink/40">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href="/" class="hover:text-ink">Beranda</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-ink/70">Layanan</li>
          </ol>
        </nav>

        <p class="kicker reveal mt-8">
          <span class="h-px w-8 bg-ink"></span>
          Layanan
        </p>
        <h1 class="reveal mt-4 max-w-3xl text-[clamp(2rem,6vw,3.75rem)]">
          Apa haja yang bisa ulun bantu?
        </h1>
        <p class="reveal mt-5 max-w-xl text-base leading-relaxed text-ink/70">
          Semua urusan IT pian di Banjarmasin bisa diurus di satu tempat — dari yang paling sederhana
          sampai yang lumayan rumit. Pilih layanan yang paling dekat dengan kebutuhan pian.
        </p>
      </div>
    </section>

    <section class="section-y border-b-2 border-ink bg-soft">
      <div class="container-x">
        <div class="grid gap-5 sm:grid-cols-2">
          {
            layananPages.map((page, index) => (
              <a
                href={`/layanan/${page.slug}/`}
                class="reveal group flex flex-col rounded-2xl border-2 border-ink bg-paper p-6 shadow-hard transition-all duration-200 hover:-translate-x-1 hover:-translate-y-1 hover:shadow-hard-lg"
              >
                <div class="flex items-start justify-between gap-4">
                  <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border-2 border-ink bg-accent">
                    <Icon name={page.icon} class="h-6 w-6" strokeWidth="2" />
                  </span>
                  <span class="font-display text-3xl leading-none text-ink/10 transition-colors group-hover:text-ink/20">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                </div>

                <h2 class="mt-5 font-sans text-xl font-extrabold normal-case leading-snug tracking-normal">
                  {page.keyword}
                </h2>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/60">{page.intro}</p>

                <span class="mt-5 inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wide text-ink">
                  Selengkapnya
                  <Icon
                    name="arrow"
                    class="h-4 w-4 transition-transform group-hover:translate-x-1"
                    strokeWidth="2.4"
                  />
                </span>
              </a>
            ))
          }
        </div>

        <p class="reveal mt-10 text-center text-sm text-ink/60">
          Butuh yang lain? Misal setting CCTV, recovery data, atau bikin website?{' '}
          <a
            href={waLink('Halo PIAN! Ulun butuh bantuan IT yang lain. Kebutuhannya: ')}
            target="_blank"
            rel="noopener"
            class="font-extrabold text-ink underline decoration-accent decoration-[3px] underline-offset-4 hover:decoration-ink"
          >
            Tanya langsung
          </a>
        </p>
      </div>
    </section>

    <section class="section-y bg-accent">
      <div class="container-x text-center">
        <h2 class="reveal mx-auto max-w-2xl text-[clamp(2rem,5.5vw,3.5rem)]">
          Belum yakin harus mulai dari mana?
        </h2>
        <p class="reveal mx-auto mt-5 max-w-lg text-sm font-medium leading-relaxed text-ink/70 sm:text-base">
          Ceritakan saja masalahnya. Ulun bantu tentukan langkah paling masuk akal, tanpa biaya
          konsultasi.
        </p>
        <a
          href={waLink('Halo PIAN! Ulun belum yakin butuh layanan apa. Masalahnya: ')}
          target="_blank"
          rel="noopener"
          class="reveal mt-8 inline-flex items-center justify-center gap-2.5 rounded-full border-2 border-ink bg-ink px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-paper shadow-hard-sm transition-all hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-hard active:translate-x-0 active:translate-y-0 active:shadow-none"
        >
          <Icon name="whatsapp" class="h-5 w-5" />
          Chat WhatsApp
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
