---
import LayananLayout from '../../layouts/LayananLayout.astro';
import { layananPages, type LayananPage } from '../../data/layanan';

export function getStaticPaths() {
  return layananPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: LayananPage;
}

const { page } = Astro.props;
---

<LayananLayout page={page} />
