---
import Icon from './Icon.astro';
import { nav, site, waDefault } from '../data/site';
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b-2 border-ink bg-paper/95 backdrop-blur-sm"
>
  <div class="container-x flex h-16 items-center justify-between gap-3 sm:h-20">
    <a href="/" class="flex shrink-0 items-center" aria-label={`${site.name} — beranda`}>
      <img
        src="/logo-lockup.png"
        alt={site.name}
        width="916"
        height="600"
        class="h-10 w-auto sm:h-12"
      />
    </a>

    <nav class="hidden items-center gap-0.5 md:flex" aria-label="Navigasi utama">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-full px-3.5 py-2 text-sm font-bold text-ink/70 transition-colors hover:bg-soft hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <a
        href={waDefault}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border-2 border-ink bg-accent px-3.5 py-2.5 text-[11px] font-extrabold uppercase tracking-wide shadow-hard-sm transition-all hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-hard active:translate-x-0 active:translate-y-0 active:shadow-none sm:px-5 sm:text-sm"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        <span>Chat WA</span>
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="grid h-10 w-10 place-items-center rounded-full border-2 border-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Buka menu"
      >
        <span class="flex w-4 flex-col gap-[3px]" aria-hidden="true">
          <span class="h-0.5 w-full bg-ink"></span>
          <span class="h-0.5 w-full bg-ink"></span>
          <span class="h-0.5 w-full bg-ink"></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t-2 border-ink bg-paper md:hidden">
    <nav class="container-x flex flex-col py-2" aria-label="Navigasi mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="border-b border-ink/10 py-3.5 text-base font-bold text-ink last:border-0"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={waDefault}
        target="_blank"
        rel="noopener"
        class="my-3 inline-flex items-center justify-center gap-2 rounded-full border-2 border-ink bg-accent px-5 py-3 text-sm font-extrabold uppercase tracking-wide shadow-hard-sm"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        Chat via WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Buka menu' : 'Tutup menu');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
