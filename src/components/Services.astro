---
import Icon from './Icon.astro';
import { services, waLink } from '../data/site';
---

<section id="layanan" class="section-y border-b-2 border-ink bg-soft">
  <div class="container-x">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="kicker reveal">
          <span class="h-px w-8 bg-ink"></span>
          Layanan
        </p>
        <h2 class="reveal mt-4 text-[clamp(2rem,5vw,3.25rem)]">
          Apa haja yang bisa<br class="hidden sm:block" /> ulun bantu?
        </h2>
      </div>
      <p class="reveal max-w-sm text-sm leading-relaxed text-ink/60 sm:text-right">
        Kada perlu bingung cari ke mana. Semua urusan IT pian bisa diurus di satu tempat, mulai dari
        yang paling sederhana sampai yang lumayan rumit.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        services.map((service) => (
          <article class="reveal group relative flex flex-col overflow-hidden rounded-2xl border-2 border-ink bg-paper shadow-hard transition-all duration-200 hover:-translate-x-1 hover:-translate-y-1 hover:shadow-hard-lg">
            <div class="flex items-start justify-between gap-4 border-b-2 border-ink bg-paper p-5 sm:p-6">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border-2 border-ink bg-accent">
                <Icon name={service.icon} class="h-6 w-6" strokeWidth="2" />
              </span>
              <span class="font-display text-3xl leading-none text-ink/10 transition-colors group-hover:text-ink/20">
                {service.no}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h3 class="text-xl sm:text-2xl">{service.title}</h3>
              <p class="mt-1.5 text-sm font-semibold text-ink/50">{service.short}</p>
              <p class="mt-4 text-sm leading-relaxed text-ink/70">{service.desc}</p>

              <ul class="mt-5 grid gap-2 sm:grid-cols-2">
                {service.points.map((point) => (
                  <li class="flex items-start gap-2 text-xs font-semibold text-ink/70">
                    <Icon name="check" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-accent-dark" strokeWidth="3" />
                    {point}
                  </li>
                ))}
              </ul>

              <a
                href={waLink(service.wa)}
                target="_blank"
                rel="noopener"
                class="mt-6 inline-flex items-center justify-between gap-2 rounded-full border-2 border-ink bg-ink px-5 py-3 text-xs font-extrabold uppercase tracking-wide text-paper transition-colors hover:bg-accent hover:text-ink"
              >
                Tanya layanan ini
                <Icon name="whatsapp" class="h-4 w-4" />
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p class="reveal mt-10 text-center text-sm text-ink/60">
      Butuh yang lain? Misal setting CCTV, recovery data, atau bikin website?{' '}
      <a
        href={waLink('Halo PIAN! Ulun butuh bantuan IT yang lain. Kebutuhannya: ')}
        target="_blank"
        rel="noopener"
        class="font-extrabold text-ink underline decoration-accent decoration-[3px] underline-offset-4 hover:decoration-ink"
      >
        Tanya langsung
      </a>
    </p>
  </div>
</section>
