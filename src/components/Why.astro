---
import Icon from './Icon.astro';
import { reasons } from '../data/site';
---

<section class="section-y border-b-2 border-ink bg-paper">
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="kicker reveal">
          <span class="h-px w-8 bg-ink"></span>
          Kenapa PIAN!
        </p>
        <h2 class="reveal mt-4 text-[clamp(2rem,5vw,3.25rem)]">
          Kada asal<br class="hidden sm:block" /> dikerjakan
        </h2>
        <p class="reveal mt-5 text-sm leading-relaxed text-ink/60">
          Ulun tahu rasanya perangkat rusak pas sedang dibutuhkan. Karena itu setiap pekerjaan
          dijelasakan dengan terbuka — apa masalahnya, apa yang dikerjakan, dan berapa biayanya.
        </p>
        <p class="reveal mt-4 text-sm leading-relaxed text-ink/60">
          Kada ada istilah teknis yang bikin bingung, kada ada biaya yang muncul belakangan.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          reasons.map((reason) => (
            <div class="reveal rounded-xl border-2 border-ink/10 bg-soft p-5 transition-colors hover:border-ink hover:bg-paper">
              <Icon name={reason.icon} class="h-6 w-6 text-ink" strokeWidth="2" />
              <h3 class="mt-3.5 font-sans text-base font-extrabold normal-case leading-snug tracking-normal">
                {reason.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/60">{reason.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
