---
import Icon from './Icon.astro';
import { testimonials } from '../data/site';
---

{
  testimonials.length > 0 && (
    <section class="section-y border-b-2 border-ink bg-ink text-paper">
      <div class="container-x">
        <div class="max-w-2xl">
          <p class="kicker reveal text-accent">
            <span class="h-px w-8 bg-accent" />
            Kata Pelanggan
          </p>
          <h2 class="reveal mt-4 text-[clamp(2rem,5vw,3.25rem)]">Kada cuma janji</h2>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {testimonials.map((t) => (
            <figure class="reveal flex h-full flex-col rounded-2xl border-2 border-paper/15 bg-paper/[0.04] p-6">
              <div class="flex gap-1 text-accent" aria-label="5 dari 5 bintang">
                {Array.from({ length: 5 }).map(() => (
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                    <path d="m12 2 3.1 6.3 7 1-5 4.9 1.2 6.9L12 17.8 5.7 21l1.2-6.9-5-4.9 7-1L12 2Z" />
                  </svg>
                ))}
              </div>
              <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-paper/80">
                “{t.quote}”
              </blockquote>
              <figcaption class="mt-6 border-t border-paper/10 pt-4">
                <p class="text-sm font-extrabold text-paper">{t.name}</p>
                <p class="text-xs text-paper/50">{t.role}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
