---
import Icon from './Icon.astro';
import { site, waLink, stats } from '../data/site';

const heroWa = waLink(
  'Halo PIAN! Ulun datang dari website. Ulun handak tanya soal layanan pian.',
);
---

<section class="relative overflow-hidden border-b-2 border-ink bg-paper">
  <!-- Ornamen garis -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.05]"
    aria-hidden="true"
    style="background-image:linear-gradient(to right,#0a0a0a 1px,transparent 1px),linear-gradient(to bottom,#0a0a0a 1px,transparent 1px);background-size:64px 64px"
  >
  </div>

  <div class="container-x relative grid items-center gap-12 py-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:py-24">
    <div>
      <p class="kicker reveal">
        <span class="dot-blink inline-block h-2 w-2 rounded-full bg-accent-dark"></span>
        IT Support · {site.area}
      </p>

      <h1 class="reveal mt-5 text-[clamp(2.5rem,7.5vw,4.75rem)]">
        Komputer pian<br />
        lambat atau error?<br />
        <span class="relative inline-block">
          <span
            class="absolute inset-x-0 bottom-[0.14em] z-0 h-[0.34em] -skew-x-6 bg-accent"
            aria-hidden="true"></span>
          <span class="relative z-10">Sini ulun anu akan!</span>
        </span>
      </h1>

      <p class="reveal mt-6 max-w-xl text-base leading-relaxed text-ink/70 sm:text-lg">
        Ulun siap me-anu akan masalah seputar IT gasan pian — servis komputer &amp; laptop,
        pembuatan aplikasi khusus, sampai undangan digital. Dijelasakan pakai bahasa yang pian
        pahami.
      </p>

      <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={heroWa}
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center justify-center gap-2.5 rounded-full border-2 border-ink bg-accent px-7 py-4 text-sm font-extrabold uppercase tracking-wide shadow-hard transition-all hover:-translate-x-1 hover:-translate-y-1 hover:shadow-hard-lg active:translate-x-0 active:translate-y-0 active:shadow-none"
        >
          <Icon name="whatsapp" class="h-5 w-5" />
          Chat WhatsApp
          <Icon
            name="arrow"
            class="h-4 w-4 transition-transform group-hover:translate-x-1"
            strokeWidth="2.4"
          />
        </a>
        <a
          href="#layanan"
          class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-ink bg-paper px-7 py-4 text-sm font-extrabold uppercase tracking-wide transition-colors hover:bg-ink hover:text-paper"
        >
          Lihat Layanan
        </a>
      </div>

      <p class="reveal mt-4 text-xs font-semibold text-ink/50">
        {site.whatsappDisplay} · {site.responseTime}
      </p>

      <dl class="reveal mt-10 grid max-w-lg grid-cols-3 gap-4 border-t-2 border-ink/10 pt-6">
        {
          stats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <span class="block font-display text-xl uppercase leading-none sm:text-2xl">
                  {stat.value}
                </span>
                <span class="mt-1.5 block text-[11px] font-bold uppercase leading-tight tracking-wide text-ink/50">
                  {stat.label}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Kartu visual -->
    <div class="reveal relative mx-auto w-full max-w-sm lg:max-w-none">
      <div class="absolute -right-3 -top-3 hidden h-full w-full rounded-2xl border-2 border-ink bg-accent sm:block" aria-hidden="true"></div>

      <div class="relative overflow-hidden rounded-2xl border-2 border-ink bg-ink p-6 shadow-hard">
        <div class="flex items-center justify-between">
          <span class="kicker text-paper/60">Live Chat</span>
          <span class="flex items-center gap-1.5 rounded-full bg-accent px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider text-ink">
            <span class="dot-blink h-1.5 w-1.5 rounded-full bg-ink"></span>
            Online
          </span>
        </div>

        <div class="mt-5 space-y-3 text-sm">
          <div class="max-w-[85%] rounded-2xl rounded-bl-sm bg-paper/10 px-4 py-3 text-paper/90">
            Halo, laptop ulun lambat banar pas dibuka. Bisa dibantu kah?
          </div>
          <div class="ml-auto max-w-[88%] rounded-2xl rounded-br-sm bg-accent px-4 py-3 font-semibold text-ink">
            Bisa banar! Kirim spek laptopnya dulu, ulun cek kemungkinan penyebabnya.
          </div>
          <div class="max-w-[70%] rounded-2xl rounded-bl-sm bg-paper/10 px-4 py-3 text-paper/90">
            Ini speknya bang 🙏
          </div>
          <div class="ml-auto flex w-fit items-center gap-1.5 rounded-2xl rounded-br-sm bg-accent px-4 py-3">
            <span class="dot-blink h-1.5 w-1.5 rounded-full bg-ink"></span>
            <span class="dot-blink h-1.5 w-1.5 rounded-full bg-ink" style="animation-delay:0.2s"></span>
            <span class="dot-blink h-1.5 w-1.5 rounded-full bg-ink" style="animation-delay:0.4s"></span>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-between border-t border-paper/15 pt-4">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-paper/40">Nomor WA</p>
            <p class="font-display text-lg tracking-wide text-paper">{site.whatsappDisplay}</p>
          </div>
          <span class="grid h-11 w-11 place-items-center rounded-full bg-accent">
            <Icon name="whatsapp" class="h-5 w-5 text-ink" />
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
