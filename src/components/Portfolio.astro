---
import Icon from './Icon.astro';
import { portfolio, waLink } from '../data/site';

const icons = ['envelope', 'monitor', 'code'];
---

<section id="portofolio" class="section-y border-b-2 border-ink bg-soft">
  <div class="container-x">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="kicker reveal">
          <span class="h-px w-8 bg-ink"></span>
          Hasil Kerja
        </p>
        <h2 class="reveal mt-4 text-[clamp(2rem,5vw,3.25rem)]">
          Contoh yang<br class="hidden sm:block" /> ulun kerjakan
        </h2>
      </div>
      <p class="reveal max-w-sm text-sm leading-relaxed text-ink/60 sm:text-right">
        Sebagian pekerjaan yang paling sering diminta. Punya kebutuhan lain? Ceritakan saja.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        portfolio.map((item, index) => (
          <article class="reveal group flex flex-col overflow-hidden rounded-2xl border-2 border-ink bg-paper shadow-hard transition-all duration-200 hover:-translate-x-1 hover:-translate-y-1 hover:shadow-hard-lg">
            <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden border-b-2 border-ink bg-ink">
              <div
                class="absolute inset-0 opacity-20"
                aria-hidden="true"
                style="background-image:linear-gradient(45deg,#c6f432 25%,transparent 25%,transparent 75%,#c6f432 75%),linear-gradient(45deg,#c6f432 25%,transparent 25%,transparent 75%,#c6f432 75%);background-size:22px 22px;background-position:0 0,11px 11px"
              />
              <div class="relative flex flex-col items-center gap-3 px-6 text-center">
                <span class="grid h-14 w-14 place-items-center rounded-2xl border-2 border-accent bg-ink">
                  <Icon name={icons[index] ?? 'code'} class="h-7 w-7 text-accent" strokeWidth="1.8" />
                </span>
                <span class="font-display text-lg uppercase leading-tight tracking-wide text-paper">
                  {item.title}
                </span>
              </div>
            </div>

            <div class="flex flex-1 flex-col p-5">
              <span class="w-fit rounded-full border border-ink/15 bg-soft px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-widest text-ink/60">
                {item.tag}
              </span>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/65">{item.desc}</p>

              {item.href ? (
                <a
                  href={item.href}
                  class="mt-4 inline-flex items-center justify-between gap-2 rounded-full border-2 border-ink px-4 py-2.5 text-[11px] font-extrabold uppercase tracking-wide transition-colors hover:bg-ink hover:text-paper"
                >
                  Lihat contoh
                  <Icon name="arrow" class="h-3.5 w-3.5" strokeWidth="2.6" />
                </a>
              ) : (
                <span class="mt-4 text-[11px] font-bold uppercase tracking-widest text-ink/35">
                  Contoh pekerjaan
                </span>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-10 text-center">
      <a
        href={waLink('Halo PIAN! Ulun handak lihat contoh hasil kerja pian dulu sebelum pesan.')}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border-2 border-ink bg-paper px-6 py-3.5 text-xs font-extrabold uppercase tracking-wide transition-colors hover:bg-ink hover:text-paper"
      >
        Minta contoh lebih banyak
        <Icon name="arrow" class="h-4 w-4" strokeWidth="2.4" />
      </a>
    </div>
  </div>
</section>
