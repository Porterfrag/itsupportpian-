---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, waLink } from '../data/site';
import { layananPages, type LayananPage } from '../data/layanan';

interface Props {
  page: LayananPage;
}

const { page } = Astro.props;
const wa = waLink(page.waMessage);
const canonical = new URL(`/layanan/${page.slug}/`, site.url).href;

const others = layananPages.filter((item) => item.slug !== page.slug);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: page.h1,
  serviceType: page.keyword,
  description: page.metaDescription,
  url: canonical,
  provider: { '@id': `${site.url}/#business` },
  areaServed: page.areas.map((name) => ({ '@type': 'Place', name })),
  availableChannel: {
    '@type': 'ServiceChannel',
    servicePhone: { '@type': 'ContactPoint', telephone: `+${site.waNumber}`, contactType: 'customer service' },
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Layanan', item: `${site.url}/#layanan` },
    { '@type': 'ListItem', position: 3, name: page.h1, item: canonical },
  ],
};
---

<Layout
  title={page.metaTitle}
  description={page.metaDescription}
  jsonLd={[serviceSchema, faqSchema, breadcrumbSchema]}>
  <Header />

  <main>
    <!-- ===== HERO ===== -->
    <section class="relative overflow-hidden border-b-2 border-ink bg-paper">
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.05]"
        aria-hidden="true"
        style="background-image:linear-gradient(to right,#0a0a0a 1px,transparent 1px),linear-gradient(to bottom,#0a0a0a 1px,transparent 1px);background-size:64px 64px"
      >
      </div>

      <div class="container-x relative py-10 sm:py-14">
        <nav aria-label="Breadcrumb" class="text-xs font-bold uppercase tracking-wider text-ink/40">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href="/" class="hover:text-ink">Beranda</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/#layanan" class="hover:text-ink">Layanan</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-ink/70">{page.keyword}</li>
          </ol>
        </nav>

        <div class="mt-8 grid items-start gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
          <div>
            <p class="kicker reveal">
              <span class="grid h-8 w-8 place-items-center rounded-lg border-2 border-ink bg-accent">
                <Icon name={page.icon} class="h-4 w-4" strokeWidth="2" />
              </span>
              {page.keyword} · {site.area}
            </p>

            <h1 class="reveal mt-5 text-[clamp(2rem,6vw,3.75rem)]">{page.h1}</h1>

            <p class="reveal mt-6 max-w-xl text-base leading-relaxed text-ink/70 sm:text-lg">
              {page.intro}
            </p>

            <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a
                href={wa}
                target="_blank"
                rel="noopener"
                class="group inline-flex items-center justify-center gap-2.5 rounded-full border-2 border-ink bg-accent px-7 py-4 text-sm font-extrabold uppercase tracking-wide shadow-hard transition-all hover:-translate-x-1 hover:-translate-y-1 hover:shadow-hard-lg active:translate-x-0 active:translate-y-0 active:shadow-none"
              >
                <Icon name="whatsapp" class="h-5 w-5" />
                Chat WhatsApp
                <Icon
                  name="arrow"
                  class="h-4 w-4 transition-transform group-hover:translate-x-1"
                  strokeWidth="2.4"
                />
              </a>
              <a
                href="#lingkup"
                class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-ink bg-paper px-7 py-4 text-sm font-extrabold uppercase tracking-wide transition-colors hover:bg-ink hover:text-paper"
              >
                Lihat detail
              </a>
            </div>

            <p class="reveal mt-4 text-xs font-semibold text-ink/50">
              {site.waDisplay} · {site.responseTime}
            </p>
          </div>

          <!-- Kartu ringkas -->
          <div class="reveal rounded-2xl border-2 border-ink bg-ink p-6 text-paper shadow-hard sm:p-7">
            <p class="kicker text-accent">
              <span class="h-px w-6 bg-accent"></span>
              Ringkas
            </p>
            <ul class="mt-5 space-y-4">
              {
                [
                  { icon: 'tag', title: 'Harga jelas di awal', desc: 'Disepakati sebelum dikerjakan' },
                  { icon: 'shield', title: 'Ada garansi', desc: 'Masalah sama, benerin lagi gratis' },
                  { icon: 'home', title: 'Bisa on-site', desc: 'Ulun datang ke lokasi pian' },
                  { icon: 'chat', title: 'Bahasa Banjar', desc: 'Kada perlu takut salah istilah' },
                ].map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-accent">
                      <Icon name={item.icon} class="h-4 w-4 text-ink" strokeWidth="2.2" />
                    </span>
                    <div>
                      <p class="text-sm font-extrabold text-paper">{item.title}</p>
                      <p class="text-xs leading-relaxed text-paper/50">{item.desc}</p>
                    </div>
                  </li>
                ))
              }
            </ul>
            <div class="mt-6 border-t border-paper/15 pt-4">
              <p class="text-[10px] font-bold uppercase tracking-widest text-paper/40">Area layanan</p>
              <p class="mt-1 text-sm font-bold text-paper">{site.area}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== GEJALA ===== -->
    <section class="section-y border-b-2 border-ink bg-soft">
      <div class="container-x">
        <div class="max-w-2xl">
          <p class="kicker reveal">
            <span class="h-px w-8 bg-ink"></span>
            Kenali gejalanya
          </p>
          <h2 class="reveal mt-4 text-[clamp(1.75rem,4.5vw,2.75rem)]">
            Gejala yang sering ulun tangani
          </h2>
          <p class="reveal mt-4 text-sm leading-relaxed text-ink/60">
            Kalau pian mengalami salah satu hal di bawah, berarti sudah waktunya dicek. Kada perlu
            tunggu sampai makin parah.
          </p>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            page.symptoms.map((symptom) => (
              <article class="reveal rounded-2xl border-2 border-ink bg-paper p-5 transition-transform hover:-translate-y-1">
                <div class="flex items-start gap-2.5">
                  <Icon name="bolt" class="mt-0.5 h-4 w-4 shrink-0 text-accent-dark" strokeWidth="2.4" />
                  <h3 class="font-sans text-sm font-extrabold normal-case leading-snug tracking-normal">
                    {symptom.title}
                  </h3>
                </div>
                <p class="mt-2.5 text-xs leading-relaxed text-ink/60">{symptom.desc}</p>
              </article>
            ))
          }
        </div>

        <p class="reveal mt-8 text-center text-sm text-ink/60">
          Gejalanya berbeda?{' '}
          <a
            href={waLink('Halo PIAN! Ulun punya masalah lain, bukan yang ada di daftar. Masalahnya: ')}
            target="_blank"
            rel="noopener"
            class="font-extrabold text-ink underline decoration-accent decoration-[3px] underline-offset-4 hover:decoration-ink"
          >
            ceritakan saja
          </a>
          — ulun bantu tebak penyebabnya.
        </p>
      </div>
    </section>

    <!-- ===== LINGKUP ===== -->
    <section id="lingkup" class="section-y border-b-2 border-ink bg-paper">
      <div class="container-x">
        <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="kicker reveal">
              <span class="h-px w-8 bg-ink"></span>
              Yang dikerjakan
            </p>
            <h2 class="reveal mt-4 text-[clamp(1.75rem,4.5vw,2.75rem)]">
              Lingkup<br class="hidden sm:block" /> pengerjaan
            </h2>
            <p class="reveal mt-5 text-sm leading-relaxed text-ink/60">
              Ini yang biasanya termasuk. Kalau kebutuhan pian di luar daftar, tetap tanyakan — sering
              masih bisa dibantu.
            </p>
            <a
              href={wa}
              target="_blank"
              rel="noopener"
              class="reveal mt-6 inline-flex items-center gap-2 rounded-full border-2 border-ink bg-accent px-5 py-3 text-xs font-extrabold uppercase tracking-wide shadow-hard-sm transition-all hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-hard active:translate-x-0 active:translate-y-0 active:shadow-none"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              Tanya kebutuhan ulun
            </a>
          </div>

          <ul class="reveal grid gap-3 sm:grid-cols-2">
            {
              page.scope.map((item) => (
                <li class="flex items-start gap-3 rounded-xl border-2 border-ink/10 bg-soft p-4">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ink">
                    <Icon name="check" class="h-3 w-3 text-accent" strokeWidth="3.5" />
                  </span>
                  <span class="text-sm font-semibold leading-relaxed text-ink/75">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== ALASAN ===== -->
    <section class="section-y border-b-2 border-ink bg-ink text-paper">
      <div class="container-x">
        <div class="max-w-2xl">
          <p class="kicker reveal text-accent">
            <span class="h-px w-8 bg-accent"></span>
            Kenapa PIAN!
          </p>
          <h2 class="reveal mt-4 text-[clamp(1.75rem,4.5vw,2.75rem)]">
            Kada asal dikerjakan
          </h2>
        </div>

        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          {
            page.reasons.map((reason, index) => (
              <article class="reveal flex gap-4 rounded-2xl border-2 border-paper/15 bg-paper/[0.04] p-5">
                <span class="font-display text-2xl leading-none text-accent">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-sans text-sm font-extrabold normal-case leading-snug tracking-normal text-paper">
                    {reason.title}
                  </h3>
                  <p class="mt-2 text-xs leading-relaxed text-paper/60">{reason.desc}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===== AREA ===== -->
    <section class="section-y border-b-2 border-ink bg-soft">
      <div class="container-x">
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
          <div>
            <p class="kicker reveal">
              <span class="h-px w-8 bg-ink"></span>
              Area layanan
            </p>
            <h2 class="reveal mt-4 text-[clamp(1.75rem,4.5vw,2.75rem)]">
              Jangkauan<br class="hidden sm:block" /> ulun
            </h2>
            <p class="reveal mt-5 text-sm leading-relaxed text-ink/60">
              Ulun berbasis di Banjarmasin. Gasan area di luar daftar, chat dulu — kalau memungkinkan
              ulun usahakan.
            </p>
          </div>

          <ul class="reveal flex flex-wrap gap-2">
            {
              page.areas.map((area) => (
                <li class="inline-flex items-center gap-1.5 rounded-full border-2 border-ink bg-paper px-3.5 py-2 text-xs font-bold">
                  <Icon name="pin" class="h-3.5 w-3.5" strokeWidth="2.2" />
                  {area}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="section-y border-b-2 border-ink bg-paper">
      <div class="container-x">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="kicker reveal">
              <span class="h-px w-8 bg-ink"></span>
              FAQ
            </p>
            <h2 class="reveal mt-4 text-[clamp(1.75rem,4.5vw,2.75rem)]">
              Sering<br class="hidden sm:block" /> ditanyakan
            </h2>
            <p class="reveal mt-5 text-sm leading-relaxed text-ink/60">
              Masih ada yang kurang jelas? Chat saja, kada perlu sungkan.
            </p>
            <a
              href={wa}
              target="_blank"
              rel="noopener"
              class="reveal mt-6 inline-flex items-center gap-2 rounded-full border-2 border-ink px-5 py-3 text-xs font-extrabold uppercase tracking-wide transition-colors hover:bg-ink hover:text-paper"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              Tanya langsung
            </a>
          </div>

          <div class="reveal divide-y-2 divide-ink/10 border-y-2 border-ink/10">
            {
              page.faqs.map((faq) => (
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
                    <span class="font-sans text-base font-extrabold normal-case leading-snug tracking-normal text-ink sm:text-lg">
                      {faq.q}
                    </span>
                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border-2 border-ink transition-transform duration-200 group-open:rotate-45 group-open:bg-accent">
                      <Icon name="plus" class="h-4 w-4" strokeWidth="2.5" />
                    </span>
                  </summary>
                  <p class="pb-6 pr-10 text-sm leading-relaxed text-ink/65">{faq.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="section-y border-b-2 border-ink bg-accent">
      <div class="container-x text-center">
        <h2 class="reveal mx-auto max-w-3xl text-[clamp(2rem,5.5vw,3.75rem)]">
          {page.keyword} kada perlu ditunda
        </h2>
        <p class="reveal mx-auto mt-5 max-w-xl text-sm font-medium leading-relaxed text-ink/70 sm:text-base">
          Makin lama dibiarkan, makin banyak yang hilang — data, waktu, atau uang. Chat ulun sekarang,
          konsultasi awal gratis.
        </p>

        <div class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={wa}
            target="_blank"
            rel="noopener"
            class="inline-flex w-full items-center justify-center gap-2.5 rounded-full border-2 border-ink bg-ink px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-paper shadow-hard-sm transition-all hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-hard active:translate-x-0 active:translate-y-0 active:shadow-none sm:w-auto"
          >
            <Icon name="whatsapp" class="h-5 w-5" />
            Chat WhatsApp Sekarang
          </a>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex w-full items-center justify-center gap-2 rounded-full border-2 border-ink px-7 py-4 text-sm font-extrabold uppercase tracking-wide transition-colors hover:bg-ink hover:text-paper sm:w-auto"
          >
            <Icon name="mail" class="h-4 w-4" strokeWidth="2.2" />
            Kirim Email
          </a>
        </div>

        <p class="reveal mt-5 text-xs font-bold uppercase tracking-widest text-ink/50">
          {site.waDisplay} · {site.hours}
        </p>
      </div>
    </section>

    <!-- ===== LAYANAN LAIN ===== -->
    <section class="section-y bg-paper">
      <div class="container-x">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div class="max-w-xl">
            <p class="kicker reveal">
              <span class="h-px w-8 bg-ink"></span>
              Layanan lain
            </p>
            <h2 class="reveal mt-4 text-[clamp(1.5rem,4vw,2.25rem)]">Mungkin pian butuh ini juga</h2>
          </div>
          <a
            href="/#layanan"
            class="reveal text-sm font-extrabold uppercase tracking-wide text-ink underline decoration-accent decoration-[3px] underline-offset-4 hover:decoration-ink"
          >
            Lihat semua layanan
          </a>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {
            others.map((item) => (
              <a
                href={`/layanan/${item.slug}/`}
                class="reveal group flex flex-col rounded-2xl border-2 border-ink bg-soft p-5 transition-all hover:-translate-y-1 hover:bg-paper hover:shadow-hard"
              >
                <span class="grid h-10 w-10 place-items-center rounded-lg border-2 border-ink bg-accent">
                  <Icon name={item.icon} class="h-5 w-5" strokeWidth="2" />
                </span>
                <h3 class="mt-4 font-sans text-sm font-extrabold normal-case leading-snug tracking-normal">
                  {item.keyword}
                </h3>
                <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wide text-ink/50 group-hover:text-ink">
                  Selengkapnya
                  <Icon
                    name="arrow"
                    class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1"
                    strokeWidth="2.4"
                  />
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
